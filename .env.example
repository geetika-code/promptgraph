# A model is required: PromptGraph ships with no canned or simulated replies.
# Any OpenAI-compatible endpoint works. For a free local model:
#   brew install ollama && ollama serve && ollama pull qwen2.5:7b
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:7b
# Only needed if your provider requires a key (leave empty for Ollama).
LLM_API_KEY=
# Cap on tokens per model call, and the "be concise" word limit added to text nodes.
LLM_MAX_TOKENS=350
LLM_MAX_WORDS=120
LLM_TIMEOUT_SECONDS=90
DATABASE_URL=sqlite:///./promptgraph.db
# Comma-separated origins allowed to call the API (only needed if the frontend is hosted separately).
CORS_ORIGINS=http://localhost:5173
